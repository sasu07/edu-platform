# Baza de date (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/dbname

# Cheie secretă JWT — OBLIGATORIE, minim 32 de caractere random.
# Aplicația refuză să pornească dacă lipsește sau e un placeholder.
# Generează: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Port API (opțional, default 8000)
# API_PORT=8000

# Email (opțional — dacă lipsesc, notificările email sunt dezactivate)
# Pentru Gmail: activează "App passwords" în contul Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresa_ta@gmail.com
SMTP_PASS=parola_aplicatie_gmail
SMTP_FROM=adresa_ta@gmail.com

# URL-ul public al platformei (folosit în linkurile din emailuri)
APP_URL=http://localhost:3000
